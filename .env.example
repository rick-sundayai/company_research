# Copy to .env.local (or run `npm run env:local`, which fills this in from the local Supabase stack).
# Never commit .env.local. The hosted values live only in Vercel env vars and GitHub Actions secrets.

# The one email allowed to sign in. Everyone else is refused. This fictional address is for local
# development only; the real one is set in Vercel and never written in the code.
ALLOWED_RESEARCHER_EMAIL=researcher@example.test

# Supabase connection (local stack values come from `supabase status`).
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=
