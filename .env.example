# Copy to .env.local (or run `npm run env:local`, which fills this in from the local Supabase stack).
# Never commit .env.local. The hosted values live only in Vercel env vars and GitHub Actions secrets.

# The one email allowed to sign in. Everyone else is refused. This fictional address is for local
# development only; the real one is set in Vercel and never written in the code.
ALLOWED_RESEARCHER_EMAIL=researcher@example.test

# Supabase connection (local stack values come from `supabase status`).
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=

# Who the nightly job says it is to the SEC, Wikipedia and State Street. The SEC asks for a name and a
# contact address. Set the real one in .env.local and the GitHub Actions secret; never in the code.
SEC_USER_AGENT="company_research researcher@example.test"

# The nightly job (`npm run night`) also needs these. Locally, the service role key comes from
# `supabase status`; the hosted ones live only in GitHub Actions secrets.
SUPABASE_SERVICE_ROLE_KEY=
# Finnhub's free tier, https://finnhub.io/dashboard
FINNHUB_API_KEY=
# Gemini on the paid tier (so content isn't used to improve Google's products), https://aistudio.google.com/apikey
GEMINI_API_KEY=
